# Copy to .env and adjust. Every setting is optional; the defaults run a single-machine install.

# The address people use to reach Kindwords, without a trailing slash. Used for share links, embed
# code and absolute photo URLs, and it turns on the Secure cookie when it starts with https://.
# Set it in production; without it, links fall back to the address each request came in on.
# PUBLIC_URL=https://reviews.example.com

# Host port for `docker compose up` (the container always listens on 3000).
# KINDWORDS_PORT=3000

# Behind a reverse proxy (nginx, Caddy, Traefik): the number of proxies in front of Kindwords, so
# the real client address is read from X-Forwarded-For for rate limiting. Leave 0 when exposed
# directly; a wrong value lets clients fake their address. The proxy must pass the original Host.
TRUSTED_PROXY_COUNT=0

# Database, chosen at install (there is no migration tool between the two).
# Default: SQLite inside the data volume.
# DATABASE_URL=file:/data/kindwords.db
# Postgres instead:
# Replace db with your Postgres host: docker-compose.yml does not start a database.
# DATABASE_URL=postgres://kindwords:change-me@db:5432/kindwords

# Photo storage. Default: local disk inside the data volume.
# STORAGE_DRIVER=local
# UPLOADS_DIR=/data/uploads
# Any S3-compatible store instead (AWS S3, Cloudflare R2, MinIO, ...):
# STORAGE_DRIVER=s3
# S3_BUCKET=kindwords
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
