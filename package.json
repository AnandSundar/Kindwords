{
  "name": "kindwords",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node widget/build.mjs && next dev",
    "build": "node widget/build.mjs && next build && node scripts/standalone-assets.mjs",
    "widget:build": "node widget/build.mjs",
    "widget:size": "node widget/build.mjs && node scripts/check-widget-size.mjs",
    "start": "node server/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "reset-password": "tsx src/cli/reset-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
